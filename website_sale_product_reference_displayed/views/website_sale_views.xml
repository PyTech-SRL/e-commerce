<odoo>
    <template
        id="products_item"
        name="Display product reference"
        inherit_id="website_sale.products_item"
        customize_show="True"
    >
        <!-- Product title in list -->
        <xpath expr="//a[@t-field='product.name']" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>
        <xpath expr="//a[@t-field='product.name']" position="after">
            <a
                itemprop="name"
                t-att-href="product_href"
                t-att-content="product.display_name"
                t-field="product.display_name"
            />
        </xpath>
    </template>
    <template
        id="product"
        name="Display product reference"
        inherit_id="website_sale.product"
        customize_show="True"
    >
        <xpath expr="//t[@t-set='additional_title']" positions="after">
            <t t-set="additional_title" t-value="product.display_name" />
        </xpath>
        <!-- Breadcrumb -->
        <xpath expr="//span[@t-field='product.name']" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>
        <xpath expr="//span[@t-field='product.name']" position="after">
            <span t-field="product.display_name" />
        </xpath>
        <!-- Product Title -->
        <xpath expr="//h1[@t-field='product.name']" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>
        <xpath expr="//h1[@t-field='product.name']" position="after">
            <h1 itemprop="name" t-field="product.display_name" />
        </xpath>
    </template>
    <template
        id="product_combination"
        name="Display variant reference"
        inherit_id="website_sale.product"
        customize_show="True"
    >
        <!-- Combination description -->
        <xpath expr="//t[@t-call='website_sale.product_price']" position="before">
            <p
                t-attf-class="js_variant_reference_displayed_parent {{'' if product_variant.default_code else 'd-none'}}"
            >
                <label for="internal_reference">
                    <strong>Internal Reference</strong>
                </label>
                <select
                    class="form-control js_variant_reference_displayed"
                    name="internal_reference"
                >
                    <option
                        t-foreach="product.product_variant_ids"
                        t-as="variant"
                        t-esc="variant.default_code"
                        t-att-value="variant.id"
                        t-att-data-combination="{str(ptav.attribute_id.id): ptav.id for ptav in variant.product_template_attribute_value_ids}"
                        t-att-selected="variant.default_code == product_variant.default_code"
                    />
                </select>
            </p>
        </xpath>
    </template>
    <template
        id="recommended_products"
        name="Display product reference"
        inherit_id="website_sale.recommended_products"
        customize_show="True"
    >
        <!-- Product title in recommended products -->
        <xpath expr="//span[@t-field='alt_product.name']" position="attributes">
            <attribute name="class" add="d-none" separator=" " />
        </xpath>
        <xpath expr="//span[@t-field='alt_product.name']" position="after">
            <span
                t-att-title="alt_product.display_name"
                t-field="alt_product.display_name"
                class="o_text_overflow"
                style="display: block;"
            />
        </xpath>
    </template>
</odoo>
